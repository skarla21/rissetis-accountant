# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# Public contact email shown on the site (also used as the contact-form To: address).
NEXT_PUBLIC_RISSETIS_EMAIL=

# Google reCAPTCHA v2 checkbox site key (public) used by the contact form.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Google reCAPTCHA v2 secret key (server-only) — verify tokens in /api/contact.
RECAPTCHA_SECRET_KEY=

# Resend API key (server-only) — https://resend.com/api-keys
RESEND_API_KEY=

# From-address for form notifications. Without a verified domain, use Resend's
# onboarding sender. Sign up at Resend with the same inbox as NEXT_PUBLIC_RISSETIS_EMAIL
# (Resend only delivers onboarding mail to your account email).
# Example: Λογιστικά Ρισσέτης <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# Google Maps API key for the embedded map.
NEXT_PUBLIC_MAPS_API_KEY=

# Password gating the /admin article manager (checked server-side in the add/remove actions).
ADMIN_PASSWORD=

# Fine-grained GitHub PAT scoped to skarla21/rissetis-accountant with Contents: Read and write.
# The admin page uses it to commit article-list changes to src/data/articles.json.
GITHUB_TOKEN=

# Vercel Deploy Hook URL (Project > Settings > Git > Deploy Hooks, branch: main).
# After an admin commit, the app POSTs here to rebuild the public site.
VERCEL_DEPLOY_HOOK_URL=
